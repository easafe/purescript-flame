{
    "name": "js-framework-benchmark-non-keyed-flame",
    "sideEffects": false,
    "version": "1.6.0",
    "description": "Purescript Flame JS Benchmark",
    "main": "index.js",
    "js-framework-benchmark": {
        "frameworkVersion": "1.6.0"
    },
    "scripts": {
        "postinstall": "spago install",
        "clean": "rm -rf dist output output-es .spago node_modules",
        "build": "spago build",
        "build-prod": "spago build && purs-backend-es build && esbuild index.js --bundle --minify --outfile=dist/bundle.js"
    },
    "keywords": [
        "purescript",
        "flame"
    ],
    "author": "Eduardo Asafe <e@asafe.dev>",
    "license": "ISC",
    "homepage": "https://github.com/krausest/js-framework-benchmark",
    "repository": {
        "type": "git",
        "url": "https://github.com/krausest/js-framework-benchmark.git"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "purescript": "^0.15.17",
        "purs-backend-es": "^1.4.3",
        "spago": "^1.0.5"
    }
}
