{
      "name": "purescript-flame",
      "license": "MIT",
      "repository": {
            "type": "git",
            "url": "https://github.com/easafe/purescript-flame.git"
      },
      "files": [
            "package.json"
      ],
      "type": "module",
      "engines": {
            "node": ">=18"
      },
      "scripts": {
            "example-server-side-rendering-client": "esbuild examples/src/ServerSideRendering/Client/server-side-rendering-client.js --bundle --minify --outfile=examples/src/ServerSideRendering/dist/server-side-rendering-client.js",
            "example-server-side-rendering": "npm run example-server-side-rendering-client",
            "example-affjax-list": "esbuild examples/src/Affjax/affjax.js --bundle --minify --outfile=examples/src/Affjax/dist/affjax.js",
            "example-counter": "esbuild examples/src/Counter/counter.js --bundle --minify --outfile=examples/src/Counter/dist/counter.js",
            "example-counters": "esbuild examples/src/Counters/counters.js --bundle --minify --outfile=examples/src/Counters/dist/counters.js",
            "example-dice": "esbuild examples/src/Dice/dice.js --bundle --minify --outfile=examples/src/Dice/dist/dice.js",
            "example-special": "esbuild examples/src/SpecialElements/special.js --bundle --minify --outfile=examples/src/SpecialElements/dist/special.js",
            "example-subscriptions": "esbuild examples/src/Subscriptions/subscriptions.js --bundle --minify --outfile=examples/src/Subscriptions/dist/subscriptions.js",
            "example-todo": "esbuild examples/src/Todo/todo.js --bundle --minify --outfile=examples/src/Todo/dist/todo.js",
            "scratchpad": "esbuild test/scratchpadloader.js --bundle --watch --outfile=test/dist/scratchpadloader.js",
            "server-side-rendering": "npm run example-server-side-rendering && node examples/src/ServerSideRendering/Server/server-side-rendering-server.js",
            "build-examples": "npm run example-affjax-list && npm run example-counter && npm run example-counters && npm run example-dice && npm run example-todo && npm run example-special && npm run example-subscriptions",
            "test": "spago test && npm run build-examples"
      },
      "devDependencies": {
            "esbuild": "^0.28.2",
            "jsdom": "^31.0.1",
            "purescript": "^0.15.17",
            "spago": "^1.0.5"
      }
}
